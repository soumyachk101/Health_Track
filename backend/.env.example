# Runtime
PORT=8000
NODE_ENV=development
JWT_SECRET=your-jwt-secret-change-in-production

# Database
# PostgreSQL/Neon connection string. For Supabase Postgres use the
# SESSION-mode pooler (port 5432) because pgxpool needs prepared statements:
#   postgresql://postgres.<project-ref>:<password>@aws-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# (URL-encode special chars in the password, e.g. @ -> %40)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require

# --- Supabase Auth (GoTrue): verify Supabase-issued RS256 access tokens ---
# SUPABASE_URL is the project URL; SUPABASE_JWKS_URL is its public JWKS endpoint.
# The Go API accepts these tokens for all protected routes; set both to enable
# Supabase Auth, otherwise the backend falls back to its legacy HS256 tokens.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# Email (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
# Force plain SMTP without STARTTLS (nodemailer "secure: false")
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=noreply@healthtrack.plus

# Frontend URL (used for email verification / password reset links)
FRONTEND_URL=http://localhost:3000

# Google OAuth (used by POST /accounts/api/google-login)
GOOGLE_CLIENT_ID=your-google-client-id

# AI APIs
# Groq chat completions (primary); falls back to OpenRouter via OPENAI_API_KEY.
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openrouter_api_key_here
# When OPENAI_API_KEY is unset, a GOOGLE_API_KEY starting with "sk-or-v1" is used instead.
GOOGLE_API_KEY=
SARVAM_API_KEY=your_sarvam_api_key_here

# CORS: comma-separated exact origins allowed in addition to the built-in
# allowlist (*.vercel.app, *.netlify.app, healthtrack.store + subdomains).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://healthtrack.store,https://www.healthtrack.store

# --- Object storage + async worker (ADR-0002) ---
# Cloudflare R2 (private bucket). The S3 endpoint is derived as
# https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com; set R2_ENDPOINT to
# override (tests / R2-compatible gateways). Leave unset and the files
# routes degrade to 503 while the app runs on the sync path.
R2_ACCOUNT_ID=your-r2-account-id
R2_BUCKET=your-r2-bucket
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# R2_ENDPOINT=

# Redis (asynq worker queue + auth revocation markers). Leave unset and the
# queue degrades to the synchronous fallback (ADR-0002 feature flag); the
# cmd/worker process refuses to start without it.
REDIS_URL=redis://localhost:6379

# --- Pure Go Auth (ADR-0001) ---
# The auth module's refresh rotation + revocation live in Redis. Leave
# REDIS_URL unset and the API degrades to an in-memory store (single
# instance, dev/tests only). The async worker still needs a real one.
# AUTH_COOKIE_DOMAIN: shared parent domain (e.g. "healthtrack.plus") so the
# ht_access/ht_refresh cookies work across app.* and api.* subdomains.
# Empty = host-only. Set in production, leave blank for local dev.
AUTH_COOKIE_DOMAIN=
# AUTH_INSECURE_COOKIES=true drops the Secure attribute so the cookie
# session works over plain http://localhost. Production: leave unset.
AUTH_INSECURE_COOKIES=false
# AUTH_COOKIE_ENABLED: the ADR-0001 feature flag. false = the /api/v1/auth
# cookie routes are not mounted and the legacy /accounts/api paths serve
# everything (rollback path).
AUTH_COOKIE_ENABLED=true
# DB_MIGRATE_ON_BOOT: false (default) keeps the API boot read-only — schema
# is applied out-of-band by `go run ./cmd/migrate`. Set true only where
# boot-time bootstrap is wanted (the integration test harness).
DB_MIGRATE_ON_BOOT=false
