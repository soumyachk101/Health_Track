# Runtime
PORT=8000
NODE_ENV=development
JWT_SECRET=your-jwt-secret-change-in-production

# Database
# PostgreSQL/Neon connection string. For Supabase Postgres use the
# SESSION-mode pooler (port 5432) because pgxpool needs prepared statements:
#   postgresql://postgres.<project-ref>:<password>@aws-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# (URL-encode special chars in the password, e.g. @ -> %40)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require

# --- Supabase Auth (GoTrue): verify Supabase-issued RS256 access tokens ---
# SUPABASE_URL is the project URL; SUPABASE_JWKS_URL is its public JWKS endpoint.
# The Go API accepts these tokens for all protected routes; set both to enable
# Supabase Auth, otherwise the backend falls back to its legacy HS256 tokens.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# Email (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
# Force plain SMTP without STARTTLS (nodemailer "secure: false")
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=noreply@healthtrack.plus

# Frontend URL (used for email verification / password reset links)
FRONTEND_URL=http://localhost:3000

# Google OAuth (used by POST /accounts/api/google-login)
GOOGLE_CLIENT_ID=your-google-client-id

# AI APIs
# Groq chat completions (primary); falls back to OpenRouter via OPENAI_API_KEY.
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openrouter_api_key_here
# When OPENAI_API_KEY is unset, a GOOGLE_API_KEY starting with "sk-or-v1" is used instead.
GOOGLE_API_KEY=
SARVAM_API_KEY=your_sarvam_api_key_here

# CORS: comma-separated exact origins allowed in addition to the built-in
# allowlist (*.vercel.app, *.netlify.app, healthtrack.store + subdomains).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://healthtrack.store,https://www.healthtrack.store
