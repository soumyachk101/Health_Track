# Go backend base URL (auth + data + admin + AI chat API). No trailing slash.
# Production is same-site, different subdomains (app.* / api.*); the client
# sends cookies with `credentials: "include"` on every request.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# --- Pure Go cookie session ---
# Identity lives in the Go backend (`/api/v1/auth/*`); the HttpOnly cookies
# `ht_access` / `ht_refresh` carry the session. There is no Supabase and no
# client-side token — nothing else to configure on the frontend.

# Optional: enable "Continue with Google" by supplying your OAuth 2.0 client
# id. When unset the Google button reports that sign-in is unconfigured.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=000000000000.apps.googleusercontent.com

# NOTE: This project intentionally ships with no third-party analytics or
# advertising cookies. If you add analytics later, document it on /privacy and
# update the CSP in vercel.json / netlify.toml before wiring it in.
