# Go backend base URL (the data/admin/chatbot API). No trailing slash.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# --- Supabase Auth (identity provider for the app) ---
# The Supabase-issued access token becomes the app session token (`ht_token`)
# that the Go backend verifies against its JWKS endpoint. Use your project's
# publishable key (newer Supabase projects) or anon key (older projects).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<your-key>
# If your project uses the classic "anon key" naming instead:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# NOTE: This project intentionally ships with no third-party analytics or
# advertising cookies. If you add analytics later, document it on /privacy and
# update the CSP in vercel.json / netlify.toml before wiring it in.
